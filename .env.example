# Copy this to .env (already gitignored -- real keys never belong in
# version control) and fill in whichever services you actually use.
# Loaded automatically by osint-mcp, hackerone-mcp, second-opinion-mcp,
# and github-security-mcp at startup (mcp-servers/dotenv_loader.py) --
# no need to `export` these in your shell. A real exported env var always
# wins over a value here, same as any standard dotenv tool.

# --- osint-mcp -------------------------------------------------------------
# All four are free-tier-usable. Only set the ones for services you want;
# each tool degrades to a plain "Error: ... must be set" string, not a
# crash, if its own key is missing.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=

# --- hackerone-mcp -----------------------------------------------------
# Your HackerOne username + a personal API token (Settings > API Token).
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# --- github-security-mcp ------------------------------------------------
# Optional -- falls back to `gh auth token` (the already-authenticated gh
# CLI's own stored credential) if neither of these is set.
GITHUB_TOKEN=
# GH_TOKEN=

# --- second-opinion-mcp --------------------------------------------------
# Set whichever ONE of these you want used as the cross-model reviewer
# (must be a DIFFERENT provider than whatever's running the main
# engagement, for it to be a genuine second opinion).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_HOST=
