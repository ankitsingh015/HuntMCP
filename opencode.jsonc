{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "huntbrain",
  // "rm **"/"rm": "deny" kept below as defense-in-depth even though it's
  // NOT the real enforcement point -- empirically, this glob-based deny did
  // not actually block `rm` in live testing (verified 2026-08-26, several
  // pattern/ordering attempts). The real "never rm, never ask" rule is
  // .opencode/plugin/scope-gate.ts's tool.execute.before hook, which shells
  // out to scripts/hooks/scope_gate_hook.py's unconditional _is_rm_command()
  // check on every Bash call -- confirmed live to block rm even under
  // `opencode run --auto`, which bypasses this declarative permission block
  // entirely. Mirrors .claude/settings.json's Bash(rm *)/Bash(rm) deny.
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "allow",
      "rm **": "deny",
      "rm": "deny"
    },
    "skill": {
      "*": "allow"
    }
  },
  // Option A (per-agent MCP tool scoping): globally hide ALL MCP tool
  // schemas from the model context. Each agent re-enables ONLY the MCP
  // servers it actually uses, via a `tools:` allowlist in its own
  // .opencode/agents/*.md frontmatter. Servers stay CONNECTED (this is
  // the documented `tools` mechanism, not `enabled:false`); this only
  // removes their schemas from agents that did not opt in. Verified on
  // OpenCode 1.18.29: agent-level `server*: true` overrides this global
  // `false`. Removing a server here without re-enabling it on its owning
  // agent WILL break that capability -- see the ownership matrix in the
  // implementation note.
  "tools": {
    "writeup-mcp*": false,
    "memory-mcp*": false,
    "lessons-mcp*": false,
    "subfinder-mcp*": false,
    "httpx-mcp*": false,
    "katana-mcp*": false,
    "nmap-mcp*": false,
    "nuclei-mcp*": false,
    "sqlmap-mcp*": false,
    "dalfox-mcp*": false,
    "ffuf-mcp*": false,
    "chainer-mcp*": false,
    "watch-mcp*": false,
    "oob-mcp*": false,
    "waf-bypass-mcp*": false,
    "browser-mcp*": false,
    "playwright-mcp*": false,
    "hackerone-mcp*": false,
    "target-discovery-mcp*": false,
    "osint-mcp*": false,
    "github-security-mcp*": false,
    "secrets-mcp*": false,
    "second-opinion-mcp*": false,
    "burp-import-mcp*": false,
    "case-mcp*": false,
    "idor-mcp*": false,
    "azure-postexploit-mcp*": false,
    "aws-postexploit-mcp*": false,
    "gcp-postexploit-mcp*": false,
    "local-privesc-mcp*": false,
    "ad-recon-mcp*": false
  },
  "mcp": {
    "writeup-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["./scripts/venv-python.sh", "mcp-servers/writeup-mcp/server.py"]
    },
    "memory-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["./scripts/venv-python.sh", "mcp-servers/memory-mcp/server.py"]
    },
    "lessons-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["./scripts/venv-python.sh", "mcp-servers/lessons-mcp/server.py"]
    },
    "subfinder-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["./scripts/venv-python.sh", "mcp-servers/subfinder-mcp/server.py"]
    },
    "httpx-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["./scripts/venv-python.sh", "mcp-servers/httpx-mcp/server.py"]
    },
