      "args": ["mcp-servers/hackerone-mcp/server.py"]
    },
    "target-discovery-mcp": {
      "type": "local",
      "enabled": true,
      "command": "./.venv/bin/python",
      "args": ["mcp-servers/target-discovery-mcp/server.py"]
    },
    "secrets-mcp": {
      "type": "local",
      "enabled": true,
      "command": "./.venv/bin/python",
      "args": ["mcp-servers/secrets-mcp/server.py"]
    },
    "second-opinion-mcp": {
      "type": "local",
