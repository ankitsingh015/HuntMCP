# Copy this to engagement.yaml (gitignored — real engagement details never
# belong in version control) before running any Tier-2 (execution-capable)
# agent. HuntBrain should write this once, at Phase 0, after you hand over
# the real program/scope details — not re-derive it on every call.
target: example.com
in_scope:
  - example.com
  - "*.example.com"
out_of_scope:
  - internal.example.com
  - staging-legacy.example.com
program_url: https://hackerone.com/example-program
authorized_on: "2026-08-22"
notes: "1 req/s per host default; no DoS; no social engineering"
# Optional (#132). Fast-path authorization classes YOU (the human) pre-approve
# ONCE here at engagement start, for a bounded, lower-blast-radius state-change
# pattern. A matching replay then needs only a single terminal confirmation
# (scripts/confirm-state-change.sh ... --class <id>) instead of the two-step
# register-then-confirm fingerprint flow -- useful when a short-lived external
# credential would expire during the round trip. It STILL requires your
# interactive keystroke, is STILL single-use, and is STILL audited; only the
# register round trip is removed. Anything not matching a listed class keeps
# the full fingerprint gate. Omit this (the default) to require the full gate
# for every state change. Only classes the build defines are honored:
#   own-account-credential-replay -- replay a short-lived, externally-issued
#     credential against ANOTHER account you already own (both identities
#     captured/on file as researcher-owned), reversible by its own
#     disconnect/revoke, creating no new resource in another tenant's data.
# preauthorized_classes:
#   - own-account-credential-replay
# Optional. Machine-readable scan policy, consumed by scan-agent before
# bulk/template-based scanner calls (mcp-servers/scan_policy.py) -- a
# program that prohibits or caps automated scanning should set this
# instead of (or in addition to) a free-text note above, so scan-agent
# itself respects it rather than relying on the orchestrator to notice
# and manually re-scope the scan task.
#   full    (default if omitted) -- no restriction, current behavior.
#   bounded -- bulk scanning allowed up to scanner_volume_cap calls.
#   manual  -- no bulk automated scanning; hand-picked checks only.
# scan_policy: full
# scanner_volume_cap: 50   # only meaningful when scan_policy is "bounded"
# Optional. A scan-identification header attached to every target-facing
# request HuntMCP sends to THIS target (consumed by mcp-servers/
# scan_headers.py -- http_probe.fetch and the httpx/nuclei/katana/ffuf/
# sqlmap/dalfox MCP servers) so the program's own access logs/WAF/SOC can
# attribute and allow-list the traffic. Many bug-bounty programs require
# this. Both fields are required together; omit both for no header (the
# default). Never attached to anything other than this target -- never to
# an LLM/provider API, a notification channel, or any other service -- and
# stripped before http_probe.fetch() follows a redirect onto a different
# host.
# scan_header_name: X-Bug-Bounty
# scan_header_value: your-handle-or-program-id
