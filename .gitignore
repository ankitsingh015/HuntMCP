# Vector database (rebuilt locally from raw .md files)
data/chroma/

# Local databases (each user has their own)
data/memory.db
data/watch.db
data/candidate-targets.db
data/burp-import.db

# Python cache
__pycache__/
*.pyc

# Logs
logs/*.log

# Environment
.env

# Cron tracking (auto-created by cron-fetch.sh)
data/.cron-seen-urls.txt

# Auto-fetched CVE writeups (scripts/fetch-cves.sh / writeup-mcp's fetch_cves
# tool) -- data/writeups/ otherwise holds only curated, reviewed writeups;
# CVE dumps stay local rather than diluting that git-tracked set. CVE IDs
# always produce filenames starting with "cve-", unlike curated writeups
# (which use ingest-writeup.sh's YYYY-MM-DD-slug.md convention).
data/writeups/cve-*.md

# Lessons Registry — real engagement data (target names, findings, client
# info) NEVER belongs in this repo, even privately. Only the sanitized
# template in knowledge/ is git-tracked. See knowledge/lessons-learned-template.md.
chat-logs/
RESUME-POINT.md
RESEARCH-TODO.md
engagement.yaml
AGENT-BRIEF.md

# Budget circuit-breaker state — per-engagement Tier-2 tool-call counter,
# reset alongside engagement.yaml at the start of each new engagement.
budget.json

# security.txt-discovered candidate targets — local catalog, not for git.
data/candidate-targets.db*

# Aggregated bounty-program scope cache (bounty_scope.py, from
# arkadiyt/bounty-targets-data) and disclosed-reports catalog cache
# (disclosed_reports.py) — both re-downloadable, not for git.
data/bounty-scope-cache/
data/disclosed-reports-cache/

# Finding-level dedup registry — per-engagement, reset alongside engagement.yaml.
findings-seen.json

# Structured audit log — per-engagement Tier-2 call log, real target data.
data/audit.jsonl

# OOB listener sessions (oob-mcp) — live target interaction data
# (source IPs, callback hits), workstation-private like chat-logs/.
data/oob-sessions/

# Duplicate-work registry — per-engagement, reset alongside engagement.yaml.
work-registry.json
data/reports/

# Tool-gap capture (mcp-servers/tool_gaps.py) — deliberately global (not
# per-target) so recurring gaps across engagements are visible; still real
# engagement data, never for git.
data/tool-gaps.jsonl

# Multi-target engagement state (mcp-servers/engagement_paths.py) — one
# directory per target (engagement.yaml/budget.json/work-registry.json/
# findings-seen.json/audit.jsonl), plus the pointer file tracking which
# target is currently active. Same real-target-data sensitivity as the
# flat files above, never for git.
data/engagements/
data/.active-engagement

# Legacy fallback for engagement_paths.py's downloads-dir command when no
# engagement is active (dev/testing use only) -- real engagement downloads
# live under data/engagements/<slug>/downloads/, already covered above.
data/downloads/

# Real hunt findings/reports living at the repo-root reports/ (as opposed
# to data/reports/, already covered above) -- discovered live 2026-08-26:
# a user's real findings (client names, vulnerability details) were
# sitting here, untracked but completely unprotected by any existing rule.
reports/

# Generated by scripts/setup-watch.sh — bakes in this machine's absolute path
scripts/huntmcp-watch-cron.sh

# Generated by scripts/setup-bounty-scope-watch.sh — same reason
scripts/huntmcp-bounty-scope-cron.sh

# Virtual environment
.venv/

# OS files
.DS_Store
Thumbs.db

# Real hunt findings/reports — client names, vulnerability details, never
# for git. This top-level reports/ was NOT covered by any existing rule
# (only data/reports/ was, and this checkout was 6+ commits behind and
# missing even that) -- added urgently 2026-08-26 after discovering real,
# untracked-but-not-ignored findings sitting here (reports/arkose-2026-08/,
# reports/wibmo-2026-08-26/).
reports/
